generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Pode mudar para "postgresql", "mysql" ou "sqlserver"
  url      = "file:./kartodromo.db"
}

model Piloto {
  cpf      String   @id @map("cpf_piloto")
  nome     String   @map("nome_piloto")
  dataNasc DateTime @map("data_nasc_piloto")
  equipe   String   @map("equipe_piloto")
  idade    Int?      @map("idade_piloto")
  numero   Int      @map("numero_piloto")
  foto     String?  @map("foto_piloto")

  @@map("tb_pilotos")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}
model Usuario { 
id Int @id @default(autoincrement())
 usuario String @unique
 email String @unique
 senha String
 }

model Funcionario {
  cpf        String   @id
  nome       String
  cargo      String
  dataNasc   DateTime
  dataAdmissao DateTime?
  salario    Float
  email      String
  foto       String?
  cep        String?
  logradouro String?
  numero     String?
  bairro     String?
  cidade     String?
  uf         String?
}

model Campeonato {
  id         Int     @id @default(autoincrement())
  nome       String  @unique
  data       DateTime? @map("data_campeonato") // <- CAMPO DE DATA ADICIONADO
  voltas     Int
  fotoPista1 String?
  fotoPista2 String?
  fotoPista3 String?
  fotoPista4 String?

}

model Historico {
  id             Int      @id @default(autoincrement())
  nomeCampeonato String   @map("nome_campeonato")
  numeroVoltas   Int      @map("numero_voltas")
  nomePrimeiro   String?  @map("nome_primeiro")
  fotoPrimeiro   String?  @map("foto_primeiro")
  nomeSegundo    String?  @map("nome_segundo")
  fotoSegundo    String?  @map("foto_segundo")
  nomeTerceiro   String?  @map("nome_terceiro")
  fotoTerceiro   String?  @map("foto_terceiro")
  pista1         String?
  pista2         String?
  pista3         String?
  pista4         String?
  createdAt      DateTime @default(now())

  @@map("tb_historico")
}