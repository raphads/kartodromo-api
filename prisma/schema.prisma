generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Pode mudar para "postgresql", "mysql" ou "sqlserver"
  url      = "file:./kartodromo.db"
}

model Piloto {
  cpf      String   @id @map("cpf_piloto")
  nome     String   @map("nome_piloto")
  dataNasc DateTime @map("data_nasc_piloto")
  equipe   String   @map("equipe_piloto")
  idade    Int      @map("idade_piloto")
  numero   Int      @map("numero_piloto")
  foto     String?  @map("foto_piloto")

  @@map("tb_pilotos")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model Funcionario {
  cpf      String   @id
  nome     String
  cargo    String
  dataNasc DateTime
  salario  Float
  email    String
  foto     String?
}

model Campeonato {
  id         Int     @id @default(autoincrement())
  nome       String  @unique
  voltas     Int
  fotoPista1 String?
  fotoPista2 String?
  fotoPista3 String?
  fotoPista4 String?
}

